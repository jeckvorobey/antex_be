APP_HOST=127.0.0.1
APP_PORT=8000
APP_ENV=dev
APP_NAME=AntEx
APP_URL=http://127.0.0.1:8000

DATABASE_URL=postgresql+asyncpg://antex:antex@localhost:5432/antex
REDIS_URL=redis://localhost:6379/0

BACKEND_CORS_ORIGINS=["http://localhost:9000","http://localhost:9001"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

LOG_LEVEL=INFO
LOG_DIR=./logs

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_HOST=
TELEGRAM_WEBHOOK_PATH=/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_INIT_DATA_TTL_SECONDS=86400
ADMIN_ID=
DEV_USER_ID=123456789
PROXY=

FRONTEND_WEBAPP_URL=http://localhost:9000

JWT_SECRET=change-me-in-local-env
JWT_ALGORITHM=HS256
JWT_TTL_SECONDS=86400
ADMIN_ACCESS_TTL_SECONDS=900
ADMIN_REFRESH_TTL_SECONDS=604800

RATE_CACHE_TTL_SECONDS=86400
CURRENCYBEACON_API_KEY=
REVIEW_CHANNEL_ID=

APP_LOCALE_DEFAULT=ru
APP_LOCALE_SUPPORTED=ru,en
